<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IsTestProject>true</IsTestProject>

    <!--
      xUnit v3 runs on Microsoft.Testing.Platform, which makes the test project an
      executable rather than a library the VSTest host loads.
    -->
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <RootNamespace>DecisionDriven.Report.Tests</RootNamespace>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="xunit.v3" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/DecisionDriven.Report/DecisionDriven.Report.csproj" />
  </ItemGroup>

</Project>
