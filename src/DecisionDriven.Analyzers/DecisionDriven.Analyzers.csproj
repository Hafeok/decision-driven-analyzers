<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!--
      netstandard2.0 is what the compiler loads analyzers from. It is not a choice about
      which consumers are supported; it is the only target a Roslyn component can have.
    -->
    <TargetFramework>netstandard2.0</TargetFramework>
    <IsRoslynComponent>true</IsRoslynComponent>
    <EnforceExtendedAnalyzerRules>true</EnforceExtendedAnalyzerRules>
    <RootNamespace>DecisionDriven.Analyzers</RootNamespace>
  </PropertyGroup>

  <PropertyGroup>
    <IsPackable>true</IsPackable>
    <PackageId>DecisionDriven.Analyzers</PackageId>
    <Title>DecisionDriven.Analyzers</Title>
    <Description>
      Roslyn analyzers that enforce decision-driven design: every rule they check exists
      because a decision says so, and the diagnostic names the decision by key. A
      development-time package; it never appears in a consumer's runtime output.
    </Description>

    <!--
      TwoPackages.DevelopmentTimeOnly. DevelopmentDependency marks the package so that a
      consumer's PackageReference defaults to PrivateAssets=all and the package cannot
      flow to whoever consumes the consumer.
    -->
    <DevelopmentDependency>true</DevelopmentDependency>

    <!--
      The assembly ships under analyzers/dotnet/cs, not lib/, so there is no build output
      to include and no dependency to declare: the compiler supplies Roslyn.
    -->
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <SuppressDependenciesWhenPacking>true</SuppressDependenciesWhenPacking>
    <IncludeSymbols>false</IncludeSymbols>

    <!--
      NU5128 is NuGet observing that the package declares a target framework but ships no
      lib/ or ref/ assets for it. For an analyzer package that is the point, not a
      mistake: a lib/ folder here would put the analyzer on a consumer's compile path.
      The pack verification in CI asserts that lib/ stays absent.
    -->
    <NoWarn>$(NoWarn);NU5128</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" PrivateAssets="all" ExcludeAssets="runtime" />
    <PackageReference Include="Microsoft.CodeAnalysis.Analyzers" PrivateAssets="all" />
  </ItemGroup>

  <!--
    Implements BuildTimeDependencies.RoslynPinEnforcedByBuild and is an instance of
    RuleTiers.BuildTargetChecksAreTierOne: a build target that fails the build is a
    tier-1 rule in the DDBUILD id family, held to the same bar as a Roslyn analyzer.
    Doc page: docs/rules/DDBUILD0001.md.

    (These will be [DesignDecision(typeof(BuildTimeDependencies.RoslynPinEnforcedByBuild))]
    once the generator of decisions-as-types emits the decision types; MSBuild has nowhere
    to put an attribute, so this comment is the citation.)

    BuildTimeDependencies.RoslynPinnedToLowestSupported, enforced rather than described.

    The floor is repeated here on purpose. Directory.Packages.props is the one file a
    dependency bot edits, and a bot that raises the Roslyn pin breaks the decision while
    every build still passes: the analyzers keep working on the SDK that CI happens to
    run, and stop working on the oldest SDK of the band, which CI never exercises. That
    is exactly the failure this repository exists to argue against - a rule nobody can
    check is a preference.

    Raising the floor is a decision about which SDKs the package supports. Make it by
    changing this line and the pin together, and say in the commit which SDK band the new
    floor belongs to.
  -->
  <PropertyGroup>
    <ExpectedRoslynVersion>5.0.0</ExpectedRoslynVersion>
  </PropertyGroup>

  <Target Name="_VerifyRoslynFloor" BeforeTargets="CoreCompile">
    <Error Condition="'%(PackageVersion.Identity)' == 'Microsoft.CodeAnalysis.CSharp' and '%(PackageVersion.Version)' != '$(ExpectedRoslynVersion)'"
           Code="DDBUILD0001"
           Text="Microsoft.CodeAnalysis.CSharp is pinned to %(PackageVersion.Version), but this project expects $(ExpectedRoslynVersion). BuildTimeDependencies.RoslynPinnedToLowestSupported pins Roslyn to the lowest version the current LTS SDK band ships, so that the analyzers load on every SDK in the band rather than only the newest. If the floor is meant to move, change ExpectedRoslynVersion in this project and the pin in Directory.Packages.props in the same commit." />
    <Error Condition="'%(PackageVersion.Identity)' == 'Microsoft.CodeAnalysis.CSharp.Workspaces' and '%(PackageVersion.Version)' != '$(ExpectedRoslynVersion)'"
           Code="DDBUILD0001"
           Text="Microsoft.CodeAnalysis.CSharp.Workspaces is pinned to %(PackageVersion.Version), but this project expects $(ExpectedRoslynVersion). The tests run the analyzers against the Roslyn they are built for, so the two pins move together or not at all." />
    <Error Condition="'%(PackageVersion.Identity)' == 'Microsoft.CodeAnalysis.Workspaces.Common' and '%(PackageVersion.Version)' != '$(ExpectedRoslynVersion)'"
           Code="DDBUILD0001"
           Text="Microsoft.CodeAnalysis.Workspaces.Common is pinned to %(PackageVersion.Version), but this project expects $(ExpectedRoslynVersion). BuildTimeDependencies.WorkspacesForCodeFixesOnly pins it with the rest of Roslyn: the host supplies the implementation at run time, and a code-fixes assembly built against a newer Workspaces than the host loads fails where the analyzer still works." />
  </Target>

  <!--
    Release tracking for the diagnostics this assembly declares. Empty for now: this
    repository ships no rules yet. A new rule is added to AnalyzerReleases.Unshipped.md
    in the same commit as the analyzer, and moves to Shipped on release.
  -->
  <ItemGroup>
    <AdditionalFiles Include="AnalyzerReleases.Shipped.md" />
    <AdditionalFiles Include="AnalyzerReleases.Unshipped.md" />
  </ItemGroup>

  <!--
    The package layout:
      analyzers/dotnet/cs/DecisionDriven.Analyzers.dll   the component the compiler loads
      build/DecisionDriven.Analyzers.props|.targets      what a consumer's build imports
    The build assets live in ../DecisionDriven.Analyzers.Package/ so that they are
    editable and reviewable as files rather than as strings inside this project.
  -->
  <ItemGroup>
    <None Include="../DecisionDriven.Analyzers.Package/DecisionDriven.Analyzers.props"
          Pack="true" PackagePath="build/DecisionDriven.Analyzers.props" Visible="false" />
    <None Include="../DecisionDriven.Analyzers.Package/DecisionDriven.Analyzers.targets"
          Pack="true" PackagePath="build/DecisionDriven.Analyzers.targets" Visible="false" />
  </ItemGroup>

  <PropertyGroup>
    <TargetsForTfmSpecificContentInPackage>
      $(TargetsForTfmSpecificContentInPackage);_PackAnalyzerAssembly
    </TargetsForTfmSpecificContentInPackage>
  </PropertyGroup>

  <!--
    TwoPackages.CodeFixesShipInSeparateAssembly: both assemblies go into analyzers/dotnet/cs of the
    one package. The compiler loads the analyzer and ignores the fixes; an IDE, or `dotnet format
    analyzers`, loads both. A consumer references one thing either way.

    The code-fixes project is built first through a ProjectReference that contributes no compile
    reference - this project must not reference Workspaces, which is what RS1038 is about - so the
    dependency exists only to order the build and find the output.
  -->
  <ItemGroup>
    <ProjectReference Include="../DecisionDriven.Analyzers.CodeFixes/DecisionDriven.Analyzers.CodeFixes.csproj"
                      ReferenceOutputAssembly="false"
                      PrivateAssets="all" />
  </ItemGroup>

  <!--
    Where the code-fixes assembly is expected. A property rather than a literal inside the target,
    so that the check below can be exercised: pointing it somewhere empty is how DDBUILD0002 is
    tested, and it is also the knob if the output layout ever moves.
  -->
  <PropertyGroup>
    <CodeFixesAssemblyPath Condition="'$(CodeFixesAssemblyPath)' == ''">$(MSBuildThisFileDirectory)../DecisionDriven.Analyzers.CodeFixes/bin/$(Configuration)/netstandard2.0/DecisionDriven.Analyzers.CodeFixes.dll</CodeFixesAssemblyPath>
  </PropertyGroup>

  <Target Name="_PackAnalyzerAssembly" DependsOnTargets="ResolveProjectReferences">
    <Error Condition="!Exists('$(CodeFixesAssemblyPath)')"
           Code="DDBUILD0002"
           Text="The code-fixes assembly was not found at $(CodeFixesAssemblyPath). TwoPackages.CodeFixesShipInSeparateAssembly puts it in the same package as the analyzers, so a package without it silently ships rules whose documented-exception path cannot be applied." />

    <ItemGroup>
      <TfmSpecificPackageFile Include="$(TargetPath)" PackagePath="analyzers/dotnet/cs" />
      <TfmSpecificPackageFile Include="$(CodeFixesAssemblyPath)" PackagePath="analyzers/dotnet/cs" />
    </ItemGroup>
  </Target>

</Project>
