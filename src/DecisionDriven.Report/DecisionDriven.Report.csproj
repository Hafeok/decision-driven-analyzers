<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- The LTS TFM. The tool runs on a build machine, not inside the compiler. -->
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <RootNamespace>DecisionDriven.Report</RootNamespace>
    <AssemblyName>DecisionDriven.Report</AssemblyName>
  </PropertyGroup>

  <PropertyGroup>
    <IsPackable>true</IsPackable>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>decisiondriven-report</ToolCommandName>

    <!--
      A tool package is built from the publish output, so the repository-wide
      IsPublishable=false would leave tools/ holding nothing but DotnetToolSettings.xml.
      The package still installs far enough to fail at the entry point, which is why CI
      checks the tool's assembly is present rather than trusting that pack succeeded.
    -->
    <IsPublishable>true</IsPublishable>

    <!--
      A tool package carries its own assemblies under tools/, so there is nothing for a
      separate symbol package to be about: NuGet rejects the .snupkg as empty. The symbols
      go inside the tool instead, which is also where a stack trace from a CI run needs
      them to be.
    -->
    <IncludeSymbols>false</IncludeSymbols>
    <DebugType>embedded</DebugType>

    <PackageId>DecisionDriven.Report</PackageId>
    <Title>DecisionDriven.Report</Title>
    <Description>
      The whole-graph reports that a single compilation cannot produce: the tier-3 half of
      decision-driven design. A .NET tool, run in CI against a built solution.
    </Description>
  </PropertyGroup>

  <!--
    The ledger model and its two readers, linked rather than copied or referenced.
    DecisionsAsTypes.LedgerIsSourceGeneratorIsReadModel makes the generator one read model over
    the ledger; the citation projection is another, and two read models of one ledger have to
    agree about what the ledger says. One copy of the reader is how they do. These five files
    depend on nothing but the BCL - the generator's diagnostics, which need Roslyn, are not
    linked - and referencing the analyzer assembly instead would put a compiler extension on a
    console tool's load path.
  -->
  <ItemGroup>
    <Compile Include="../DecisionDriven.Analyzers/Ledger/DecisionKey.cs" Link="Ledger/DecisionKey.cs" />
    <Compile Include="../DecisionDriven.Analyzers/Ledger/FrontMatterReader.cs" Link="Ledger/FrontMatterReader.cs" />
    <Compile Include="../DecisionDriven.Analyzers/Ledger/Identifiers.cs" Link="Ledger/Identifiers.cs" />
    <Compile Include="../DecisionDriven.Analyzers/Ledger/LedgerModel.cs" Link="Ledger/LedgerModel.cs" />
    <Compile Include="../DecisionDriven.Analyzers/Ledger/NTriplesReader.cs" Link="Ledger/NTriplesReader.cs" />
  </ItemGroup>

  <!--
    The SDK's trimming, AOT and single-file analyzers, from
    BuildTimeDependencies.OffTheShelfBeforeOwnRule. They cost nothing here and they are
    the reason this project will not quietly grow a reflection dependency.
  -->
  <PropertyGroup>
    <EnableTrimAnalyzer>true</EnableTrimAnalyzer>
    <EnableAotAnalyzer>true</EnableAotAnalyzer>
    <EnableSingleFileAnalyzer>true</EnableSingleFileAnalyzer>
  </PropertyGroup>

</Project>
