# Normalise everything to LF in the repository. Git checks out what the platform
# wants; what is stored and what analyzers read is always LF.
* text=auto eol=lf

# The ledger's N-Triples export. Line-based, and a diagnostic quotes lines from it,
# so the line endings are part of the contract rather than a detail.
*.nt text eol=lf

# Sources and project files.
*.cs      text eol=lf diff=csharp
*.csproj  text eol=lf
*.props   text eol=lf
*.targets text eol=lf
*.sln     text eol=lf
*.slnx    text eol=lf
*.json    text eol=lf
*.md      text eol=lf
*.yml     text eol=lf
*.yaml    text eol=lf
*.editorconfig text eol=lf

# Scripts whose interpreter cares.
*.sh  text eol=lf
*.ps1 text eol=crlf
*.cmd text eol=crlf
*.bat text eol=crlf

# Binary.
*.png   binary
*.jpg   binary
*.ico   binary
*.snk   binary
*.nupkg binary
*.dll   binary
*.exe   binary
